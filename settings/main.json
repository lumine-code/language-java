{
  ".source.java": {
    "editor": {
      "commentStart": "// ",
      "commentDelimiters": {
        "block": ["/*", "*/"],
        "line": "//"
      }
    }
  },
  ".source.java-properties": {
    "editor": {
      "commentStart": "# ",
      "commentDelimiters": {
        "line": "#"
      }
    }
  },
  ".comment.block.documentation.javadoc.java": {
    "editor": {
      "completions": [
        "author",
        "deprecated",
        "exception",
        "link",
        "param",
        "return",
        "see",
        "serial",
        "since",
        "throws",
        "version"
      ]
    }
  }
}
